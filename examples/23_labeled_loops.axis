// ============================================
// AXIS Example 23: Labeled Loop Control
// Script Mode – demonstrates @flag on loops
// with stop @flag and skip @flag
// ============================================

mode script

// 1. Basic stop (break) – innermost loop
writeln("=== Basic stop ===")
i: i32 = 0
while i < 10:
    when i == 5:
        stop
    writeln(i)
    i = i + 1

// 2. Basic skip (continue) – innermost loop
writeln("")
writeln("=== Basic skip ===")
for j in range(0, 10):
    when j == 3:
        skip
    when j == 7:
        skip
    writeln(j)

// 3. Named stop – break outer loop from inner
writeln("")
writeln("=== Named stop (break outer) ===")
@outer while True:
    for k in range(0, 5):
        when k == 2:
            writeln("Breaking outer at k=2")
            stop @outer
        writeln(k)
    writeln("This should never print")

// 4. Named skip – continue outer loop from inner
writeln("")
writeln("=== Named skip (continue outer) ===")
x: i32 = 0
@rows while x < 3:
    y: i32 = 0
    while y < 3:
        when x == 1:
            writeln("Skipping row 1")
            x = x + 1
            skip @rows
        write(x)
        write(",")
        writeln(y)
        y = y + 1
    x = x + 1

// 5. Labeled for loop with stop
writeln("")
writeln("=== Labeled for ===")
@search for a in range(0, 5):
    for b in range(0, 5):
        when a == 2:
            when b == 1:
                writeln("Found at 2,1")
                stop @search

// 6. Labeled repeat (infinite loop) with stop
writeln("")
writeln("=== Labeled repeat ===")
count: i32 = 0
@counter repeat:
    count = count + 1
    when count == 5:
        stop @counter
    writeln(count)

writeln("")
writeln("=== All labeled loop tests passed ===")
