// Example 27: GCD & LCM
// Greatest Common Divisor via the Euclidean algorithm.

mode script

func gcd(x: i32, y: i32) -> i32:
    a: i32 = copy x
    b: i32 = copy y
    while b != 0:
        temp: i32 = copy b
        b = a % b
        a = copy temp
    return a

func lcm(a: i32, b: i32) -> i32:
    return (a / gcd(a, b)) * b

write("gcd(48, 18)  = ")
writeln(gcd(48, 18))
write("gcd(100, 75) = ")
writeln(gcd(100, 75))

write("lcm(12, 8)   = ")
writeln(lcm(12, 8))
write("lcm(7, 13)   = ")
writeln(lcm(7, 13))
