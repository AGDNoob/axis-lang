// Example 03: Arithmetic
// Basic operators and compound assignment.

mode script

a: i32 = 17
b: i32 = 5

writeln("a = 17, b = 5")
write("a + b = ")
writeln(a + b)
write("a - b = ")
writeln(a - b)
write("a * b = ")
writeln(a * b)
write("a / b = ")
writeln(a / b)
write("a % b = ")
writeln(a % b)

// Compound assignment
x: i32 = 10
write("x = 10 -> ")
x += 5
write("+=5 -> ")
writeln(x)

x -= 3
write("  -=3 -> ")
writeln(x)

x *= 4
write("  *=4 -> ")
writeln(x)

x /= 6
write("  /=6 -> ")
writeln(x)
