// Example 05: Conditionals
// AXIS uses "when" instead of "if".

mode script

age: i32 = 20

when age >= 18:
    writeln("Adult")
else when age >= 13:
    writeln("Teenager")
else:
    writeln("Child")

// Grading
score: i32 = 85
write("Score ")
write(score)
write(" -> Grade: ")
when score >= 90:
    writeln("A")
else when score >= 80:
    writeln("B")
else when score >= 70:
    writeln("C")
else when score >= 60:
    writeln("D")
else:
    writeln("F")
