// Example 06: For Loops
// Range-based and collection-based iteration.

mode script

// Count from 1 to 5
writeln("Counting 1-5:")
for i in range(1, 6):
    writeln(i)

// Iterate over an array
writeln("Array elements:")
nums: (i32; 4) = [10, 20, 30, 40]
for n in nums:
    write("  ")
    writeln(n)

// Nested: multiplication table
writeln("3x3 table:")
for row in range(1, 4):
    for col in range(1, 4):
        write(row * col)
        write("\t")
    writeln("")
