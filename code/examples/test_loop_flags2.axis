// Test: Loop Flags with repeat
// Tests @flag on repeat (infinite loop) with stop from nested loop.

mode script

// Test: Flagged repeat with stop @main from inner while
writeln("Test: repeat + stop @main")
count: i32 = 0
@main repeat:
    inner: i32 = 0
    while inner < 3:
        when count == 2 and inner == 1:
            writeln("breaking outer at count=2, inner=1")
            stop @main
        inner += 1
    count += 1
    writeln(count)
writeln("exited")
