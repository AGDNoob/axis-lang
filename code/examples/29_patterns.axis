// Example 29: Number Patterns
// Nested loops to draw text-based patterns.

mode script

// Right triangle
writeln("Right triangle:")
for row in range(1, 6):
    for col in range(0, row):
        write("* ")
    writeln("")

// Number triangle
writeln("Number triangle:")
for row in range(1, 6):
    for col in range(1, row + 1):
        write(col)
        write(" ")
    writeln("")

// Rectangle
writeln("Rectangle 5x3:")
for row in range(0, 3):
    for col in range(0, 5):
        write("# ")
    writeln("")
