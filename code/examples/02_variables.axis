// Example 02: Variables & Types
// AXIS supports signed/unsigned integers, booleans, and strings.

mode script

// Signed integers
a: i8 = 127
b: i16 = 32000
c: i32 = 42
d: i64 = 1000000

// Unsigned integers
e: u8 = 255
f: u32 = 100

// Boolean and string
active: bool = True
name: str = "AXIS"

// Zero-initialized by default
count: i32

writeln("Signed:")
write("  i8  = ")
writeln(a)
write("  i16 = ")
writeln(b)
write("  i32 = ")
writeln(c)
write("  i64 = ")
writeln(d)

writeln("Unsigned:")
write("  u8  = ")
writeln(e)
write("  u32 = ")
writeln(f)

write("active = ")
writeln(active)
write("name   = ")
writeln(name)
write("count  = ")
writeln(count)
