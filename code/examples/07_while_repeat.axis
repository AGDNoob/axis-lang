// Example 07: While & Repeat Loops
// "while" checks before each iteration; "repeat" loops forever until "stop".

mode script

// While: powers of 2
writeln("Powers of 2:")
n: i32 = 1
while n <= 128:
    writeln(n)
    n = n * 2

// Repeat: count to 5 then stop
writeln("Counting to 5:")
counter: i32 = 0
repeat:
    counter += 1
    writeln(counter)
    when counter == 5:
        stop
