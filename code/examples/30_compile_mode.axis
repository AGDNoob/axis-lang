// Example 30: Compile Mode
// Standalone binary with main() entry point.
// Build: axis 30_compile_mode.axis -o demo --elf

mode compile

func factorial(n: i32) -> i32:
    result: i32 = 1
    i: i32 = 2
    while i <= n:
        result = result * i
        i += 1
    return result

func is_prime(n: i32) -> i32:
    when n < 2:
        return 0
    d: i32 = 2
    while d * d <= n:
        when n % d == 0:
            return 0
        d += 1
    return 1

func main() -> i32:
    writeln("=== AXIS Compile Mode ===")
    writeln("")

    writeln("Factorials:")
    for i in range(1, 11):
        write("  ")
        write(i)
        write("! = ")
        writeln(factorial(i))

    writeln("")
    writeln("Primes up to 50:")
    write("  ")
    for n in range(2, 51):
        when is_prime(n) == 1:
            write(n)
            write(" ")
    writeln("")

    return 0
