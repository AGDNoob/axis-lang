// Test: Loop Flags
// Tests @flag syntax on while, repeat, for loops with stop/skip.

mode script

// Test 1: Basic flagged while with stop @outer
writeln("Test 1: stop @outer from inner loop")
@outer while True:
    writeln("outer start")
    x: i32 = 0
    while x < 3:
        writeln(x)
        when x == 1:
            stop @outer
        x += 1
    writeln("should not print")
writeln("after outer")

// Test 2: Flagged for with skip @loop
writeln("Test 2: skip @loop (skip outer iteration)")
@loop for i in range(0, 5):
    when i == 2:
        skip @loop
    writeln(i)
writeln("after for")

// Test 3: Nested for with stop @search
writeln("Test 3: nested for - stop @search")
@search for i in range(0, 5):
    for j in range(0, 5):
        when i * 5 + j == 7:
            writeln("found at")
            writeln(i)
            writeln(j)
            stop @search
writeln("search done")

// Test 4: Unflagged loops still work
writeln("Test 4: unflagged loop")
counter: i32 = 0
while counter < 3:
    writeln(counter)
    counter += 1
writeln("done")
