// EXPECT: 45
mode compile
func main() i32:
    r: i32 = 0
    i: i32 = 0
    while i < 10:
        match i:
            0:
                r = r + 0
            1:
                r = r + 1
            2:
                r = r + 2
            3:
                r = r + 3
            4:
                r = r + 4
            5:
                r = r + 5
            6:
                r = r + 6
            7:
                r = r + 7
            8:
                r = r + 8
            _:
                r = r + 9
        i = i + 1
    return r & 255
