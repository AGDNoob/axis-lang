// EXPECT: 55
mode compile
func main() i32:
    arr: (i32; 10) = [9, 3, 7, 1, 8, 2, 6, 4, 10, 5]
    i: i32 = 0
    while i < 10:
        j: i32 = 0
        while j < 9:
            when arr[j] > arr[j + 1]:
                t: i32 = copy arr[j]
                arr[j] = copy arr[j + 1]
                arr[j + 1] = t
            j = j + 1
        i = i + 1
    s: i32 = 0
    i = 0
    while i < 10:
        s = s + arr[i]
        i = i + 1
    return s
